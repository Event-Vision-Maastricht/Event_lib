@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

set(EVENT_LIB_WITH_OPENCV @EVENT_LIB_WITH_OPENCV@)
if (EVENT_LIB_WITH_OPENCV)
    find_dependency(OpenCV COMPONENTS core highgui imgproc)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/event_libTargets.cmake")

if (EVENT_LIB_WITH_OPENCV AND TARGET event_lib::event_lib)
    set_property(TARGET event_lib::event_lib APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES ${OpenCV_INCLUDE_DIRS}
    )
endif()
